@inproceedings{10.1145/3679240.3734665,
author = {Roy, Millend and Pyltsov, Vladimir and Godse, Ruturaj and Dear, Tony},
title = {Dynamic Incentive Design for Demand Response in Energy System MicroGrids},
year = {2025},
isbn = {9798400711251},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3679240.3734665},
doi = {10.1145/3679240.3734665},
abstract = {The integration of renewable energy sources into microgrids introduces variability and unpredictability, requiring innovative solutions to balance supply and demand. Demand Response (DR) programs incentivize consumers to adjust energy usage during critical periods, reducing grid stress and improving efficiency. This paper presents a dynamic DR incentive framework that leverages day-ahead forecasts to optimize price discounts while maintaining occupant comfort. Using contextual multi-armed bandits (MAB) and mixed-integer linear programming (MILP), our approach dynamically adapts to fluctuating renewable generation, energy prices, and consumer preferences. Unlike traditional rule-based methods, it optimizes incentives to maximize consumer participation and grid stability while minimizing reliance on costly diesel generators. Simulation results demonstrate significant improvements in financial sustainability and operational efficiency, highlighting the potential of data-driven incentive designs for resilient and adaptive energy systems.},
booktitle = {Proceedings of the 16th ACM International Conference on Future and Sustainable Energy Systems},
pages = {928–935},
numpages = {8},
keywords = {Demand Response, Contextual Bandits, optimization, mixed-integer linear programming.},
location = {
},
series = {E-Energy '25},
code = {https://github.com/MillendRoy/Demand-Response-Incentives},
preview={demand_response.png}
}

